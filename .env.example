# Postgres connection (create the database first: psql -U postgres -c "CREATE DATABASE smart_queue;")
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_queue?schema=public"

# Redis connection. On Windows the service sometimes binds only to 127.0.0.1, not localhost.
REDIS_URL="redis://127.0.0.1:6379"

# HMAC secret for the `staff` cookie. Use any 32+ random chars for dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-32-random-bytes"

# Port the custom Next + Socket.IO server binds to.
PORT=3001
