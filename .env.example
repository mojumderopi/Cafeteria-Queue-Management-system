# Smart Queue — environment variables.
# install.ps1 (Windows) or install.sh (Linux/macOS) will copy this to `.env` and
# fill in a fresh SESSION_SECRET automatically. You only need to edit this if
# Postgres lives somewhere other than the default localhost install.

# PostgreSQL — the bootstrap script creates the `smart_queue` database if missing.
# Replace YOUR_PASSWORD with the password you set during the Postgres install.
# If you used the default 'postgres' user with no password on Linux, just leave
# the host/port and clear the password (the script will prompt if needed).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_queue?schema=public"

# Redis — bootstrap starts it on 127.0.0.1:6379 (no auth).
REDIS_URL="redis://127.0.0.1:6379"

# HMAC secret for the `staff` cookie. The install script writes a random one
# here the first time you run it. Anyone running the project locally inherits
# the freshly-generated value.
SESSION_SECRET="change-me-to-32-random-bytes"

# Port for the custom Next + Socket.IO server. Default 3001 because Apache
# (and many other tools) love to grab 3000 on developer machines.
PORT=3001
