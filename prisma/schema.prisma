// Prisma schema for Smart Queue Cafeteria MVP
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CASHIER
  KITCHEN
  ADMIN
}

enum OrderStatus {
  PENDING_CASHIER
  APPROVED
  REJECTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  name         String?
  passwordHash String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  orders        Order[]
  staffCounters StaffCounter[]
}

model StaffCounter {
  id        String   @id @default(cuid())
  userId    String
  counterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@unique([userId, counterId])
  @@index([userId])
  @@index([counterId])
}

model Provider {
  id        String   @id @default(cuid())
  // Globally unique slug for the initial implementation. A later phase
  // may relax this to (slug, ownerId) or similar if multiple platforms
  // ever need to coexist.
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  counters Counter[]
}

model Counter {
  id        String     @id @default(cuid())
  // A counter is always owned by exactly one provider. The providerId
  // column is added by the Phase 1 migration after a backfill, then
  // made NOT NULL. The schema is tightened to non-nullable to match
  // the post-migration state and avoid a `migrate dev` drift detection
  // that would attempt to relax the column.
  providerId String
  slug      String     @unique
  name      String
  qrSecret  String     @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  provider  Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  menuItems MenuItem[]
  orders    Order[]
  staff     StaffCounter[]

  @@index([providerId])
}

model MenuItem {
  id                String  @id @default(cuid())
  counterId         String
  name              String
  description       String?
  price             Int // in smallest currency unit (e.g. cents/poisha)
  stockQty          Int     @default(0)
  lowStockThreshold Int     @default(3)
  isAvailable       Boolean @default(true)
  // Soft-delete: NULL = active, non-null = archived. Archived items are
  // hidden from the student-facing menu and from new orders, but historical
  // OrderItem rows still resolve via the FK relationship.
  archivedAt        DateTime?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  counter   Counter     @relation(fields: [counterId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([counterId])
  @@index([archivedAt])
}

model Order {
  id            String        @id @default(cuid())
  token         String        @unique
  counterId     String
  userId        String?
  guestPhone    String?
  status        OrderStatus   @default(PENDING_CASHIER)
  paymentStatus PaymentStatus @default(UNPAID)
  priorityScore Float         @default(0)
  totalCents    Int           @default(0)
  rejectReason  String?
  createdAt     DateTime      @default(now())
  approvedAt    DateTime?
  readyAt       DateTime?
  completedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  counter    Counter     @relation(fields: [counterId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]

  @@index([counterId, status])
  @@index([priorityScore])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String
  qty        Int
  unitPrice  Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}